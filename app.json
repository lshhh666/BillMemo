{
  "expo": {
    "name": "PureCash",
    "slug": "BillMemo",
    "version": "1.3.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "purecash",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
